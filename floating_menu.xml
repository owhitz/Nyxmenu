<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="#151515" android:padding="12dp" android:elevation="10dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NYX MENU v1.0" android:textColor="#D8B4E2" android:textSize="18sp" android:textStyle="bold" android:gravity="center" android:paddingBottom="8dp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D8B4E2" android:layout_marginBottom="8dp"/>
    <Switch android:id="@+id/switchAimbot" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aimbot" android:textColor="#FFFFFF" />
    <Spinner android:id="@+id/spinnerTarget" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:backgroundTint="#D8B4E2" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FOV: 120" android:id="@+id/txtFov" android:textColor="#D8B4E2" android:textSize="12sp" android:layout_marginTop="8dp"/>
    <SeekBar android:id="@+id/seekFov" android:layout_width="match_parent" android:layout_height="wrap_content" android:progress="50" android:progressTint="#D8B4E2" android:thumbTint="#D8B4E2" />
    <Switch android:id="@+id/switchEsp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ESP (Caixas)" android:textColor="#FFFFFF" android:layout_marginTop="4dp"/>
    <Button android:id="@+id/btnClose" android:layout_width="match_parent" android:layout_height="40dp" android:text="FECHAR" android:textSize="12sp" android:backgroundTint="#D8B4E2" android:textColor="#000000" android:layout_marginTop="8dp"/>
</LinearLayout>
